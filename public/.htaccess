# o2switch (Apache) — SPA React/Vite + durcissement sécurité
# Copié à la racine de dist/ au build : uploader avec index.html et assets/.
# Ne déployer QUE le contenu de dist/ (ou aypik-deploy.zip), jamais le dépôt source.
#
# Entrée HTML : index.php (nonce CSP par requête pour Turnstile). Fallback index.html.

Options -Indexes
ServerSignature Off
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Bloquer fichiers / dossiers sensibles s'ils étaient uploadés par erreur
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(\.env|\.env\..*|\.git|\.gitignore|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|tsconfig.*|vite\.config\..*|Dockerfile.*)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "(?i)\.(sql|bak|old|orig|swp|dist|map|md|toml|yml|yaml)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Interdire chemins cachés / sources / config
  RewriteRule (^|/)\. - [F,L]
  RewriteRule (?i)^(src|supabase|node_modules|\.git|scripts|migrations)(/|$) - [F,L]
  RewriteRule (?i)\.(env|sql|bak|old|config\.js)$ - [F,L]

  # SPA : index.php (nonce CSP). Les /assets/ manquants restent en 404
  # (sinon Apache servirait du HTML à la place d’un .js — CSP / parse error).
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^index\.html$ index.php [L]
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By

  # Les CSP multiples se cumulent (la plus stricte gagne). On retire
  # d'abord celle d'o2switch/cPanel. La CSP applicative est posée par
  # index.php (nonce aléatoire par requête — requis pour Turnstile).
  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy-Report-Only
  Header always unset Content-Security-Policy-Report-Only

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # HTML sans cache (nonce CSP + hash d'assets).
  <FilesMatch "^(index\.html|index\.php)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
