# o2switch (Apache) — SPA React/Vite + durcissement sécurité
# Copié à la racine de dist/ au build : uploader avec index.html et assets/.
# Ne déployer QUE le contenu de dist/ (ou aypik-deploy.zip), jamais le dépôt source.

Options -Indexes
ServerSignature Off

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# Bloquer fichiers / dossiers sensibles s'ils étaient uploadés par erreur
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(\.env|\.env\..*|\.git|\.gitignore|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|tsconfig.*|vite\.config\..*|Dockerfile.*)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "(?i)\.(sql|bak|old|orig|swp|dist|map|md|toml|yml|yaml)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Interdire chemins cachés / sources / config
  RewriteRule (^|/)\. - [F,L]
  RewriteRule (?i)^(src|supabase|node_modules|\.git|scripts|migrations)(/|$) - [F,L]
  RewriteRule (?i)\.(env|sql|bak|old|config\.js)$ - [F,L]

  # SPA fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Les CSP multiples se cumulent (la plus stricte gagne). On retire
  # d'abord celle d'o2switch/cPanel avant d'en poser une compatible React.
  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy-Report-Only
  Header always unset Content-Security-Policy-Report-Only

  # script-src 'self' : JS compilé dans /assets/*.js
  # 'unsafe-inline' / 'unsafe-eval' : filet Vite/React + Stripe
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'sha256-F9ONkTeFRjW5+xKyhVbobzanK6JR47UXTtwOTFz2xdI=' https://js.stripe.com https://*.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://*.stripe.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://geo.api.gouv.fr https://api.stripe.com https://*.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com https://*.stripe.com https://www.paypal.com https://www.sandbox.paypal.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.paypal.com https://www.sandbox.paypal.com; frame-ancestors 'none'"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # index.html sans cache : sinon le navigateur garde l'ancien hash d'assets.
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
