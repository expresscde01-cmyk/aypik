# o2switch (Apache) — SPA React/Vite + durcissement sécurité
# Copié à la racine de dist/ au build : uploader avec index.html et assets/.
# Ne déployer QUE le contenu de dist/ (ou aypik-deploy.zip), jamais le dépôt source.

Options -Indexes
ServerSignature Off
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Bloquer fichiers / dossiers sensibles s'ils étaient uploadés par erreur
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(\.env|\.env\..*|\.git|\.gitignore|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|tsconfig.*|vite\.config\..*|Dockerfile.*)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "(?i)\.(sql|bak|old|orig|swp|dist|map|md|toml|yml|yaml)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Interdire chemins cachés / sources / config
  RewriteRule (^|/)\. - [F,L]
  RewriteRule (?i)^(src|supabase|node_modules|\.git|scripts|migrations)(/|$) - [F,L]
  RewriteRule (?i)\.(env|sql|bak|old|config\.js)$ - [F,L]

  # SPA : index.html. Les /assets/ manquants restent en 404
  # (sinon Apache servirait du HTML à la place d’un .js — CSP / parse error).
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# PowerBoost (LiteSpeed) n'expose souvent PAS mod_headers.c : un IfModule
# autour de Header ferait tout ignorer (aucun Cache-Control / CSP en prod).
# Directive Header native LiteSpeed + Apache si le module est chargé.

Header unset X-Powered-By
Header always unset X-Powered-By

# Les CSP multiples se cumulent (la plus stricte gagne). On retire
# d'abord celle d'o2switch/cPanel / Tiger Protect / Report-Only.
Header unset Content-Security-Policy
Header always unset Content-Security-Policy
Header unset Content-Security-Policy-Report-Only
Header always unset Content-Security-Policy-Report-Only

# Bundle Vite ('self') + scripts/connexions Supabase et Stripe.
# 'unsafe-inline' sur script-src-elem : un script intégré (hébergeur,
# Stripe iframe) ne doit pas bloquer la page. Pas de hash sha256 :
# un hash annule 'unsafe-inline'.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://js.stripe.com https://m.stripe.network https://*.stripe.com https://dtsyeouinmpjvdgwkncu.supabase.co https://*.supabase.co; script-src-elem 'self' 'unsafe-inline' https://js.stripe.com https://m.stripe.network https://*.stripe.com https://dtsyeouinmpjvdgwkncu.supabase.co https://*.supabase.co; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://dtsyeouinmpjvdgwkncu.supabase.co https://*.supabase.co https://*.stripe.com; connect-src 'self' https://dtsyeouinmpjvdgwkncu.supabase.co wss://dtsyeouinmpjvdgwkncu.supabase.co https://*.supabase.co wss://*.supabase.co https://geo.api.gouv.fr https://api.stripe.com https://q.stripe.com https://m.stripe.network https://r.stripe.com https://*.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://*.stripe.com https://www.paypal.com https://www.sandbox.paypal.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.paypal.com https://www.sandbox.paypal.com; frame-ancestors 'none'"

Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set X-Permitted-Cross-Domain-Policies "none"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
Header always set Cross-Origin-Resource-Policy "same-site"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# index.html sans cache : sinon le navigateur garde l'ancien hash d'assets.
<FilesMatch "^index\.html$">
  Header always set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|svg|woff2)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
