# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Stripe (clé publique uniquement côté client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal (Client ID public)
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Resend — NE PAS préfixer par VITE_ (secret serveur uniquement).
# À dupliquer dans les secrets Supabase Edge Functions :
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_FROM_EMAIL="Aypik <bonjour@votredomaine.fr>"
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Aypik <onboarding@resend.dev>

# --- Secrets à configurer dans Supabase (Edge Functions) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PREMIUM_PRICE_ID=price_...   # Prix récurrent 19,99 € / mois
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_PREMIUM_PLAN_ID=P-...       # Plan Billing 19,99 € / mois
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PUBLIC_SITE_URL=http://localhost:5173
#   (URL publique du site — utilisée dans les pieds de page e-mail /
#    lien « Gérer mes préférences » : /?open=preferences)
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=Aypik <bonjour@votredomaine.fr>
