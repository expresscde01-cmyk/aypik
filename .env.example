# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# E-mails produit (Resend via Edge Function send-email — voir docs/EMAIL.md)
# edge = actif (défaut) | noop = aucun envoi (tests)
VITE_EMAIL_PROVIDER=edge

# Offres
# Freemium UI : SHOW_FREEMIUM dans src/lib/membership.ts (false = Fondateur seul)
# Paiements : ENABLE_PAYMENTS dans src/lib/payments.ts

# Paiements Stripe / PayPal
# Systèmes présents. ENABLE_PAYMENTS = true dans src/lib/payments.ts.
# Les Membres Fondateurs sont auto-validés à 0 € (pas de checkout).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal (Client ID public)
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# --- Secrets à configurer dans Supabase (Edge Functions) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PREMIUM_PRICE_ID=price_...   # Prix récurrent 19,99 € / mois
# STRIPE_WEBHOOK_SECRET=whsec_...    # + event payment_intent.succeeded (Boost)
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_PREMIUM_PLAN_ID=P-...       # Plan Billing 19,99 € / mois
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PUBLIC_SITE_URL=http://localhost:5173
# SUPABASE_SERVICE_ROLE_KEY=...
# Boost 24 h = PaymentIntent / Order 2,99 € (pas de Price ID Stripe requis)
#
# Resend (e-mails applicatifs — PAS dans VITE_*)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Aypik <bonjour@votredomaine.fr>
