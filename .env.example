# Supabase — clés PUBLIQUES uniquement (préfixe VITE_ = exposées dans le bundle JS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Cloudflare Turnstile — site key PUBLIQUE (widget connexion / contact / mot de passe)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Dev local (Vite) : copier dans .env.development.local (gitignored), pas dans .env.
# Ne pas préfixer les secrets. Le build production (`npm run deploy`) ignore ce fichier.
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<anon affichée par supabase start>
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Secret Turnstile local (supabase/.env, pour l’Edge Function) :
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Stripe — clé PUBLIABLE uniquement (jamais sk_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal — Client ID public uniquement (jamais le Client Secret)
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Resend — NE PAS préfixer par VITE_ (secret serveur uniquement).
# Obligatoire sur le projet hébergé, sinon « Mot de passe oublié » et les mails
# transactionnels échouent. Le .env local ne suffit PAS :
#   npx supabase secrets set RESEND_API_KEY=re_xxx --project-ref dtsyeouinmpjvdgwkncu
#   npx supabase secrets set RESEND_FROM_EMAIL="Aypik <bonjour@votredomaine.fr>" --project-ref dtsyeouinmpjvdgwkncu
#   npx supabase secrets set EMAIL_HOOK_SECRET="long-random-secret" --project-ref dtsyeouinmpjvdgwkncu
#   npx supabase secrets set PUBLIC_SITE_URL=https://aypik.fr --project-ref dtsyeouinmpjvdgwkncu
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Aypik <onboarding@resend.dev>

# --- Secrets à configurer UNIQUEMENT dans Supabase Dashboard / Edge Function secrets ---
# JAMAIS dans le front, JAMAIS avec le préfixe VITE_, JAMAIS dans aypik-deploy.zip :
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_PREMIUM_PLAN_ID=P-...
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PUBLIC_SITE_URL=https://votre-domaine.fr
# SUPABASE_SERVICE_ROLE_KEY=...   # accès admin total — ultra sensible
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=Aypik <bonjour@votredomaine.fr>
# EMAIL_HOOK_SECRET=...           # même valeur que email_dispatch_settings.hook_secret
# TURNSTILE_SECRET_KEY=0x...      # même clé secrète Cloudflare que Auth → Attack Protection
#                                 # (widget déjà utilisé à la connexion ; site key = VITE_TURNSTILE_SITE_KEY)
