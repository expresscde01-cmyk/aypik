# Supabase — clés PUBLIQUES uniquement (préfixe VITE_ = exposées dans le bundle JS)
# Si absentes au build, src/lib/supabase.ts utilise le projet aypik.fr
# (dtsyeouinmpjvdgwkncu) pour que aypik-deploy.zip ne parte pas vide.
VITE_SUPABASE_URL=https://dtsyeouinmpjvdgwkncu.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Stripe — clé PUBLIABLE uniquement (jamais sk_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal — Client ID public uniquement (jamais le Client Secret)
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Resend — NE PAS préfixer par VITE_ (secret serveur uniquement).
# Obligatoire sur le projet hébergé, sinon « Mot de passe oublié » et les mails
# transactionnels échouent. Le .env local ne suffit PAS :
#   npx supabase secrets set RESEND_API_KEY=re_xxx --project-ref dtsyeouinmpjvdgwkncu
#   npx supabase secrets set RESEND_FROM_EMAIL="Aypik <bonjour@votredomaine.fr>" --project-ref dtsyeouinmpjvdgwkncu
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Aypik <onboarding@resend.dev>

# --- Secrets à configurer UNIQUEMENT dans Supabase Dashboard / Edge Function secrets ---
# JAMAIS dans le front, JAMAIS avec le préfixe VITE_, JAMAIS dans aypik-deploy.zip :
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_PREMIUM_PLAN_ID=P-...
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PUBLIC_SITE_URL=https://votre-domaine.fr
# SUPABASE_SERVICE_ROLE_KEY=...   # accès admin total — ultra sensible
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=Aypik <bonjour@votredomaine.fr>
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...  # hook Auth Send Email (auth-send-email)
